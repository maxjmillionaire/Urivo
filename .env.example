# Urivo environment — copy to .env and fill in. NEVER commit .env.
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost:3000

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (platform.claude.com → API keys) — server-only, for store generation
ANTHROPIC_API_KEY=

# Upstash Redis (upstash.com) — optional; rate limiting across instances.
# Falls back to in-memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
