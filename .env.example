# Urivo environment — copy to .env (local) or set on Railway → Variables.
# NEVER commit .env. Grouped by what each is needed for.

# ── App ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
ROOT_DOMAIN=localhost:3000

# Admin allow-list for the internal finance dashboard (/admin/finance).
# Comma-separated emails, matched case-insensitively. Unset = nobody is admin
# (fail closed). Never commit real addresses; set this on Railway → Variables.
ADMIN_EMAILS=

# Shared secret for the scheduled weekly business digest. Set this to a long
# random string and give the same value to your scheduler (see LAUNCH.md).
# Unset = the /api/cron/weekly-digest endpoint is disabled (fails closed).
CRON_SECRET=

# ── REQUIRED to launch — the product does not function without these ──
# Supabase (Dashboard → Project Settings → API). Provision the database by
# pasting supabase/setup_all.sql into the SQL Editor once (it contains every
# migration in order). Regenerate that file with `npm run db:build`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only admin key. REQUIRED — credits, generation and webhooks all use
# it. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (platform.claude.com → API keys) — server-only. REQUIRED — powers
# ALL AI: store generation, Ask Urivo, market research, ad studio.
ANTHROPIC_API_KEY=

# Optional model routing. Every AI action runs on the default model unless
# overridden here — useful for shifting a single expensive action onto a
# cheaper model without a deploy. Leave unset to use the built-in default.
#   URIVO_MODEL_DEFAULT            — the fallback for every action
#   URIVO_MODEL_STORE_GENERATION   — the hero generation
#   URIVO_MODEL_STORE_EDIT         — Ask Urivo applying an edit
#   URIVO_MODEL_ASSISTANT          — Ask Urivo conversation
#   URIVO_MODEL_MARKET_RESEARCH    — market research
#   URIVO_MODEL_AD_STUDIO          — ad studio
#   URIVO_MODEL_NAMING             — brand naming
#   URIVO_MODEL_PRODUCT_OPTIMIZER  — product optimiser
URIVO_MODEL_DEFAULT=

# ── Strongly recommended for a quality launch ───────────────────────
# Higgsfield (higgsfield.ai) — product photography. Without it, stores
# generate but products fall back to palette planes (no photos).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_IMAGE_SIZE=
HIGGSFIELD_IMAGE_QUALITY=1080p
# Optional image fallback if Higgsfield is unavailable.
GOOGLE_AI_API_KEY=
GOOGLE_AI_IMAGE_MODEL=

# Upstash Redis (upstash.com) — rate limiting across instances. Without it,
# limits fall back to in-memory PER INSTANCE — unreliable on serverless.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend (resend.com) — transactional email (welcome, etc.). Suppressed
# (only logged) when unset.
RESEND_API_KEY=
EMAIL_FROM=Urivo <hello@urivo.ai>

# Sentry (sentry.io) — production error alerting. Without it you are blind
# to runtime errors (they only go to logs).
SENTRY_DSN=
# PostHog — product analytics (optional).
NEXT_PUBLIC_POSTHOG_KEY=

# ── Phase 2 — Stripe (billing + storefront commerce via Connect) ─────
# Not needed for a free-tier launch; required before paid plans / checkout.
# Subscriptions, credit packs and the billing portal are wired and waiting on
# these keys. Storefront payouts additionally need Connect onboarding, which is
# not built yet — see LAUNCH.md, Block 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
